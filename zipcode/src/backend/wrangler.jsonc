// ===================================================================
// src/backend/wrangler.jsonc — unchanged, no D1 needed for this component
// ===================================================================
{
  "name": "hd-backend",
  "main": "index.js",
  "compatibility_date": "2025-09-12",
  "dev": {
    "port": 3001
  },
  "compatibility_flags": [
    "nodejs_compat",
    "enable_nodejs_http_server_modules",
    "enable_nodejs_http_modules",
    "experimental"
  ],
  "vars": {
    "DEV_DOMAIN": "",
    "STAGING_DOMAIN": "",
    "PROD_DOMAIN": "",
    "ENVIRONMENT": "development"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hypersprint-postal",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}